{
  "dependencies": {
    "@google/genai": "^3.3.0",
    "dom-accessibility-api": "^0.7.1",
    "marked": "^15.0.12",
    "notivue": "^2.4.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^4.6.5",
    "webextension-polyfill": "^0.12.0"
  },
  "description": "Your form filling AI assistant",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.20.0",
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/ei": "^1.2.2",
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "~8.42.3",
    "@types/node": "^22.20.5",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.13",
    "@vueuse/core": "^12.8.2",
    "chalk": "^5.6.2",
    "chrome-types": "^0.1.464",
    "commander": "^13.1.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "daisyui": "^5.8.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "get-installed-browsers": "^0.1.7",
    "globals": "^15.15.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.108.2",
    "tailwindcss": "^4.0.5",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-turbo-console": "^1.11.3",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.11.2",
    "vite": "^6.4.6",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue-tsc": "^2.2.12",
    "vuefire": "^3.2.3",
    "web-ext": "^8.10.0",
    "webext-bridge": "^6.0.1"
  },
  "displayName": "Formacer",
  "name": "formacer-v3",
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "pnpm": {
    "overrides": {},
    "peerDependencyRules": {
      "allowAny": [],
      "allowedVersions": {
        "node-fetch": "*"
      },
      "ignoreMissing": []
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "protobufjs",
      "spawn-sync",
      "vue-demi"
    ]
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dumbbellcode/formacer"
  },
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome-dev": "cross-env NODE_ENV=production vite build --mode development -c vite.chrome.config.ts",
    "build:chrome": "cross-env NODE_ENV=production vite build --mode production -c vite.chrome.config.ts",
    "build:firefox": "cross-env NODE_ENV=production vite build -c vite.firefox.config.ts",
    "dev": "npm run build:chrome-dev",
    "dev:chrome": "cross-env NODE_ENV=development vite -c vite.chrome.config.ts",
    "dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "launch": "tsx scripts/launch.ts",
    "launch:all": "tsx scripts/launch.ts --all",
    "lint": "eslint . --fix --cache",
    "lint:manifest": "web-ext lint --pretty",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.6",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true,
    "spawn-sync@1.0.15": true,
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.6.0": true
  },
  "volta": {
    "node": "24.22.3"
  }
}
